<Window x:Class="ClipVault.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:vm="clr-namespace:ClipVault.ViewModels"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="{Binding WindowTitle}"
        Width="{Binding WindowWidth, Mode=TwoWay}"
        Height="{Binding WindowHeight, Mode=TwoWay}"
        MinWidth="320" MinHeight="400"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- 分割线颜色：提高到 35% 透明度，肉眼可见 -->
        <SolidColorBrush x:Key="DividerBrush" Color="#59808080"/>
        <!-- 置顶强调线颜色 -->
        <SolidColorBrush x:Key="PinAccentBrush" Color="#0078D7"/>

        <!-- 外层容器样式：底边分割线 -->
        <Style x:Key="RowWrapperStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- 内层条目样式：左侧置顶蓝线（默认透明） -->
        <Style x:Key="RowItemStyle" TargetType="Border">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="3,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource PinAccentBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Search bar + filters -->
        <Grid Grid.Row="0" Margin="8,8,8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     x:Name="SearchBox"
                     Text="{Binding SearchInputText, UpdateSourceTrigger=PropertyChanged}"
                     ui:ControlHelper.PlaceholderText="搜索... (Enter 确认)"
                     Margin="0,0,6,0"
                     KeyDown="SearchBox_KeyDown"/>

            <ComboBox Grid.Column="1" Margin="0,0,6,0" Width="100"
                      SelectedValuePath="Tag"
                      SelectedValue="{Binding TimeFilter}">
                <ComboBoxItem Content="全部时间" Tag="all" IsSelected="True"/>
                <ComboBoxItem Content="今天" Tag="today"/>
                <ComboBoxItem Content="最近7天" Tag="7days"/>
                <ComboBoxItem Content="最近30天" Tag="30days"/>
            </ComboBox>

            <!-- 类型下拉，含收藏入口 -->
            <ComboBox Grid.Column="2" Width="90"
                      SelectedValuePath="Tag"
                      SelectedValue="{Binding TypeFilter}">
                <ComboBoxItem Content="全部类型" Tag="all" IsSelected="True"/>
                <ComboBoxItem Content="仅文本" Tag="text"/>
                <ComboBoxItem Content="仅链接" Tag="link"/>
                <Separator/>
                <ComboBoxItem Content="★ 收藏" Tag="favorites"/>
            </ComboBox>
        </Grid>

        <!-- Status row -->
        <TextBlock Grid.Row="1"
                   Text="{Binding StatusText}"
                   Margin="12,0,12,4"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                   FontSize="12"/>

        <!-- List -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid>
                <!-- Empty state -->
                <TextBlock Text="{Binding EmptyMessage}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="0,60,0,0"
                           FontSize="14"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                           Visibility="{Binding HasNoItems, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <ItemsControl ItemsSource="{Binding Items}"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ClipItemViewModel}">
                            <!-- 外层：底部分割线 -->
                            <Border Style="{StaticResource RowWrapperStyle}"
                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}">

                                <!-- 右键菜单挂在外层 Border 上 -->
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="复制"
                                                  Command="{Binding PlacementTarget.Tag.CopyItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}"/>
                                        <Separator/>
                                        <MenuItem Command="{Binding PlacementTarget.Tag.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}">
                                            <MenuItem.Style>
                                                <Style TargetType="MenuItem">
                                                    <Setter Property="Header" Value="  收藏"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                            <Setter Property="Header" Value="  取消收藏"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </MenuItem.Style>
                                        </MenuItem>
                                        <MenuItem Command="{Binding PlacementTarget.Tag.TogglePinnedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}">
                                            <MenuItem.Style>
                                                <Style TargetType="MenuItem">
                                                    <Setter Property="Header" Value="  置顶"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                            <Setter Property="Header" Value="  取消置顶"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </MenuItem.Style>
                                        </MenuItem>
                                        <Separator/>
                                        <MenuItem Header="删除"
                                                  Foreground="Red"
                                                  Command="{Binding PlacementTarget.Tag.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}"/>
                                    </ContextMenu>
                                </Border.ContextMenu>

                                <!-- 内层：左侧置顶蓝线 -->
                                <Border Style="{StaticResource RowItemStyle}">
                                <StackPanel>
                                    <!-- Header row -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Pin icon -->
                                        <TextBlock Grid.Column="0" Text="📌" FontSize="11" Margin="0,0,5,0"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                        <!-- Preview text (click = copy + close) -->
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Preview}"
                                                   MaxHeight="40"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   ToolTip="{Binding Content}"
                                                   MouseLeftButtonUp="PreviewText_Click"/>

                                        <!-- Favorite star (always visible when favorited) -->
                                        <TextBlock Grid.Column="2" Text="★" FontSize="11"
                                                   Foreground="#FFD700"
                                                   Margin="4,0,2,0"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                        <!-- Relative time -->
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding RelativeTime}"
                                                   FontSize="11"
                                                   Margin="4,0,4,0"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                   VerticalAlignment="Center"/>

                                        <!-- Expand button -->
                                        <Button Grid.Column="4"
                                                Content="⋯"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="4,0"
                                                VerticalAlignment="Center"
                                                Command="{Binding DataContext.ToggleExpandCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>

                                    <!-- Expanded detail panel -->
                                    <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Margin="0,8,0,4">
                                        <Border Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                                                CornerRadius="4" Padding="8" Margin="0,0,0,8">
                                            <TextBlock Text="{Binding Content}"
                                                       TextWrapping="Wrap"
                                                       FontFamily="Consolas"
                                                       FontSize="13"/>
                                        </Border>

                                        <!-- Action buttons -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="复制" Margin="0,0,4,0"
                                                    Command="{Binding DataContext.CopyItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Margin="0,0,4,0"
                                                    Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Content" Value="☆ 收藏"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                <Setter Property="Content" Value="★ 已收藏"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Margin="0,0,4,0"
                                                    Command="{Binding DataContext.TogglePinnedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Content" Value="📌 置顶"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                                <Setter Property="Content" Value="📌 取消置顶"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="🗑 删除" Foreground="Red"
                                                    Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                                </Border>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
