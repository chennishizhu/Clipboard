<Window x:Class="ClipVault.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:vm="clr-namespace:ClipVault.ViewModels"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="{Binding WindowTitle}"
        Width="{Binding WindowWidth, Mode=TwoWay}"
        Height="{Binding WindowHeight, Mode=TwoWay}"
        MinWidth="320" MinHeight="400"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- Type label style -->
        <Style x:Key="TypeLabelStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumBrush}"/>
        </Style>

        <!-- Card style -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Margin" Value="8,4"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltMediumBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Search bar + filters -->
        <Grid Grid.Row="0" Margin="8,8,8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 普通 TextBox，按 Enter 搜索，Esc 清空 -->
            <TextBox Grid.Column="0"
                     x:Name="SearchBox"
                     Text="{Binding SearchInputText, UpdateSourceTrigger=PropertyChanged}"
                     ui:ControlHelper.PlaceholderText="搜索... (按 Enter 确认)"
                     Margin="0,0,6,0"
                     KeyDown="SearchBox_KeyDown"/>

            <ComboBox Grid.Column="1" Margin="0,0,6,0" Width="100"
                      SelectedValuePath="Tag"
                      SelectedValue="{Binding TimeFilter}">
                <ComboBoxItem Content="全部时间" Tag="all" IsSelected="True"/>
                <ComboBoxItem Content="今天" Tag="today"/>
                <ComboBoxItem Content="最近7天" Tag="7days"/>
                <ComboBoxItem Content="最近30天" Tag="30days"/>
            </ComboBox>

            <ComboBox Grid.Column="2" Width="90"
                      SelectedValuePath="Tag"
                      SelectedValue="{Binding TypeFilter}">
                <ComboBoxItem Content="全部类型" Tag="all" IsSelected="True"/>
                <ComboBoxItem Content="仅文本" Tag="text"/>
                <ComboBoxItem Content="仅链接" Tag="link"/>
            </ComboBox>
        </Grid>

        <!-- Favorites mode banner -->
        <Border Grid.Row="1"
                Background="{DynamicResource SystemAccentColorBrush}"
                Padding="12,4"
                Visibility="{Binding FavoritesOnly, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <TextBlock Text="★ 收藏夹" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Content="返回全部" HorizontalAlignment="Right"
                        Padding="8,2" FontSize="12"
                        Click="ExitFavorites_Click"/>
            </Grid>
        </Border>

        <!-- Status row -->
        <TextBlock Grid.Row="2"
                   Text="{Binding StatusText}"
                   Margin="12,0,12,4"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                   FontSize="12"/>

        <!-- List -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <Grid>
                <!-- Empty state -->
                <TextBlock Text="{Binding EmptyMessage}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="0,60,0,0"
                           FontSize="14"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                           Visibility="{Binding HasNoItems, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <ItemsControl ItemsSource="{Binding Items}"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ClipItemViewModel}">
                            <Border Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorBrush}"/>
                                                <Setter Property="BorderThickness" Value="2,0,0,0"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <!-- 右键菜单 -->
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="复制"
                                                  Command="{Binding PlacementTarget.Tag.CopyItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}"/>
                                        <Separator/>
                                        <MenuItem Command="{Binding PlacementTarget.Tag.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}">
                                            <MenuItem.Style>
                                                <Style TargetType="MenuItem">
                                                    <Setter Property="Header" Value="  收藏"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                            <Setter Property="Header" Value="  取消收藏"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </MenuItem.Style>
                                        </MenuItem>
                                        <MenuItem Command="{Binding PlacementTarget.Tag.TogglePinnedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}">
                                            <MenuItem.Style>
                                                <Style TargetType="MenuItem">
                                                    <Setter Property="Header" Value="  置顶"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                            <Setter Property="Header" Value="  取消置顶"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </MenuItem.Style>
                                        </MenuItem>
                                        <Separator/>
                                        <MenuItem Header="删除"
                                                  Foreground="Red"
                                                  Command="{Binding PlacementTarget.Tag.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}"/>
                                    </ContextMenu>
                                </Border.ContextMenu>

                                <StackPanel>
                                    <!-- Header row -->
                                    <Grid Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Pin icon -->
                                        <TextBlock Grid.Column="0" Text="📌" FontSize="12" Margin="0,0,4,0"
                                                   Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                        <!-- Preview text (click = copy + close) -->
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Preview}"
                                                   MaxHeight="40"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Content}"
                                                   MouseLeftButtonUp="PreviewText_Click"/>

                                        <!-- Relative time -->
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding RelativeTime}"
                                                   FontSize="11"
                                                   Margin="6,0,4,0"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                   VerticalAlignment="Center"/>

                                        <!-- Expand button -->
                                        <Button Grid.Column="3"
                                                Content="⋯"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="4,0"
                                                Command="{Binding DataContext.ToggleExpandCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>

                                    <!-- Expanded detail panel -->
                                    <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Margin="0,8,0,0">
                                        <Border Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                                                CornerRadius="4" Padding="8" Margin="0,0,0,8">
                                            <TextBlock Text="{Binding Content}"
                                                       TextWrapping="Wrap"
                                                       FontFamily="Consolas"
                                                       FontSize="13"/>
                                        </Border>

                                        <!-- Action buttons -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="复制" Margin="0,0,4,0"
                                                    Command="{Binding DataContext.CopyItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Margin="0,0,4,0"
                                                    Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Content" Value="☆ 收藏"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                <Setter Property="Content" Value="★ 已收藏"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Margin="0,0,4,0"
                                                    Command="{Binding DataContext.TogglePinnedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Content" Value="📌 置顶"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                                <Setter Property="Content" Value="📌 取消置顶"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="🗑 删除" Foreground="Red"
                                                    Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
